{
  "name": "buildingtea",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BuildingTea: paste an NYC address, get a plain-English report on the building from public city records.",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite build --config web/vite.config.ts && wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && wrangler deploy --dry-run",
    "deploy": "pnpm run build && wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply buildingtea --local",
    "migrate:remote": "wrangler d1 migrations apply buildingtea --remote",
    "email:preview": "tsx scripts/email-preview.ts",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.13.0",
    "stripe": "^23.0.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
